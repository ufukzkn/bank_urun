@using BankUrun.Web.ViewModels
@model DashboardMonthlyDetailViewModel
<div class="sub-product-contribution-section">
    <div class="detail-section-heading">
        <h3>Alt ürün katkıları</h3>
        <p>Alt ürünlerin hedefi yoktur; ortak alt ürün her bağlı ana ürüne tam gerçekleşme katkısı sağlar.</p>
    </div>
    @await Html.PartialAsync("_ProductFlowVisual",
        new ProductFlowViewModel
        {
            CenterTitle = Model.Title,
            CenterSubtitle = Model.Subtitle,
            CenterLabel = "Ana ürün",
            Heading = "Besleyen alt ürünler",
            Description = "Oklar katkının alt üründen seçili ana ürüne aktığını gösterir.",
            ValueLabel = "Gerçekleşme",
            ShowDistribution = true,
            Items = Model.Contributions.Select(item => new ProductFlowItemViewModel
            {
                Code = item.Code,
                Name = item.Name,
                Value = item.ActualValue,
                SharedRelationCount = item.SharedRelationCount
            }).ToList()
        })
</div>
