@model BankUrun.Web.ViewModels.TargetPageViewModel

@if (Model.Rows.Count == 0)
{
    <tr class="empty-row"><td colspan="11" class="empty-cell">Filtreye uygun hedef bağlamı bulunamadı.</td></tr>
}
@foreach (var row in Model.Rows)
{
    var detailId = $"target-{row.PortfolioId}-{row.ParameterId}";
    <tr class="list-row" data-detail-id="@detailId">
        <td>@row.Year</td>
        <td>@row.Term. Dönem</td>
        <td><strong>@row.GroupNo</strong><small>@row.GroupName</small></td>
        <td><strong>@row.BranchCode</strong><small>@row.BranchName</small></td>
        <td><strong>@row.PortfolioCode</strong><small>@row.PortfolioName</small></td>
        <td>@await Html.PartialAsync("_RelationBadges", new[] { new BankUrun.Web.ViewModels.RelationBadgeViewModel { Label = $"{row.ProductGamutCode} · {row.ProductGamutName}", Title = row.ProductGamutName } })</td>
        <td><strong>@row.MainProductCode</strong><small>@row.MainProductName</small></td>
        <td><span class="status-pill">@((row.CalculationType == BankUrun.Web.Models.MainProductCalculationType.Average) ? "Ortalamalı" : "Kümülatif")</span></td>
        <td class="text-end numeric-cell"><strong>@row.PeriodTarget.ToString("N2")</strong><small>@row.EnteredMonthCount / 6 ay</small></td>
        <td><span class="status-pill @(row.HasCompleteTarget ? "status-active" : "status-passive")">@(row.HasCompleteTarget ? "Hazır" : "Eksik")</span></td>
        <td class="text-end"><button class="btn btn-sm btn-outline-primary detail-button" type="button" data-bs-toggle="collapse" data-bs-target="#@detailId" data-target-detail data-parameter-id="@row.ParameterId" data-portfolio-id="@row.PortfolioId">Detay</button></td>
    </tr>
    <tr class="list-detail-row" data-detail-for="@detailId">
        <td colspan="11">
            <div class="collapse" id="@detailId">
                <div class="main-product-target-detail" data-target-editor>
                    <div class="inline-empty-state">Hedef editörü Detay açıldığında yüklenir.</div>
                </div>
            </div>
        </td>
    </tr>
}
